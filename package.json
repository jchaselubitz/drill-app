{
  "name": "drill-app",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "scripts": {
    "start:expo": "expo start",
    "start:expo:tunnel": "expo start --tunnel",
    "new": "rm -rf node_modules && rm -rf .expo && rm -rf ios && rm -rf android && yarn cache clean && yarn install",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo start --dev-client && expo run:ios --device",
    "clean:ios": "npx expo prebuild -p ios --clean",
    "build:ios": "npx expo run:ios --configuration Release",
    "build:device": "npx expo run:ios --configuration Release --device",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\""
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@expo/app-integrity": "~55.0.17",
    "@expo/log-box": "55.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.46",
    "@react-navigation/native": "^7.1.33",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "expo": "^55.0.32",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-background-task": "~55.0.22",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "lightningcss": "1.30.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.7.4",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "expo-mcp": "~0.2.4",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.12.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
